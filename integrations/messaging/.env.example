# Copy to .env; never commit actual tokens.
LAIN_API_KEY=
LAIN_API_BASE_URL=https://lain-os.com/v1
LAIN_MODEL=lain-free
BOT_CONTEXT_MESSAGES=10

# Slack: one test app installed in one test workspace.
# App token: xapp-... with connections:write; bot token: xoxb-...
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_ALLOWED_TEAMS=T_REPLACE
SLACK_ALLOWED_USERS=U_ORPHEUS
SLACK_ALLOWED_CHANNELS=C_TEST_CHANNEL

# Discord: one bot installed in one test guild.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=ORPHEUS_DISCORD_USER_ID
DISCORD_ALLOWED_GUILDS=TEST_GUILD_ID
DISCORD_ALLOWED_CHANNELS=TEST_CHANNEL_ID
