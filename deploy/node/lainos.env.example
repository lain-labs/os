# Lain OS on the node — copy to secrets/lainos.env, mode 0600.
# Free OpenRouter models only: no Lain OS credits, no paid fallback, no standby
# agent. Give this key a $0 credit limit on openrouter.ai so a mistake cannot cost money.
LAINOS_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-…
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_SMALL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL_MEDIUM=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_LARGE=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_CHEAP=openrouter/free
LAINOS_MODEL_FALLBACK=none
LAINOS_MODEL_STANDBY=none
LAINOS_EMBED_PROVIDER=hash

# Pictures cost money (image); the MetaMask CLI is not in the image (metamask).
LAINOS_DISABLE_PLUGINS=image,metamask
# Background loops spend the free models' daily quota; the desk on the
# workstation keeps the calendar and the wallet.
LAINOS_INITIATIVE=0
LAINOS_STUDY=0
LAINOS_TRADER=0
LAINOS_PRESS=0
LAINOS_TELEGRAM_POLL=0

# The forge, on a free coding model, committing to the mounted clone.
LAINOS_FORGE_AGENT=opencode
LAINOS_FORGE_OPENCODE_MODEL=openrouter/poolside/laguna-s-2.1:free
LAINOS_FORGE_REPO=/app

# The HTTP bridge: lain-os.com's relay sends this as a bearer. openssl rand -hex 32
LAINOS_HTTP_KEY=…
# Bearers of the subagents: API_SERVER_KEY in hermes.env, OPENCLAW_GATEWAY_TOKEN in openclaw.env.
LAINOS_SUBAGENT_HERMES_KEY=…
LAINOS_SUBAGENT_OPENCLAW_KEY=…

TZ=Europe/Moscow
