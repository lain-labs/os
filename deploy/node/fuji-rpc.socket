[Unit]
Description=The validator's node API as a socket for the Lain node's containers
Documentation=file:///home/lain/lain-node/lainos/README.md

# Rootless containers cannot reach the host's loopback, where avalanchego's API
# listens; a bind-mounted socket reaches it without opening that to the network.
[Socket]
ListenStream=/run/lain-node/fuji.sock
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
