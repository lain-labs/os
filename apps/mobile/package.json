{
    "name": "lainos-mobile",
    "version": "1.0.0",
    "private": true,
    "description": "Lain OS mobile application shell (Android)",
    "license": "MIT",
    "type": "commonjs",
    "scripts": {
        "www": "node scripts/build-www.js",
        "sync": "npm run www && cap sync android",
        "sync:android": "npm run www && cap sync android",
        "assets": "capacitor-assets generate --iconBackgroundColor '#03060f' --iconBackgroundColorDark '#03060f' --splashBackgroundColor '#03060f' --splashBackgroundColorDark '#03060f'",
        "open:android": "cap open android",
        "android:apk": "npm run sync:android && cd android && ./gradlew assembleDebug",
        "android:release": "npm run sync:android && cd android && ./gradlew bundleRelease",
        "doctor": "cap doctor",
        "test": "node --test test/*.test.js",
        "sync:play": "LAIN_STORE=play npm run sync:android",
        "android:bundle": "npm run sync:play && cd android && ./gradlew bundleRelease"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/core": "^8.5.0",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/push-notifications": "^8.1.3",
        "@capacitor/share": "^8.0.3",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.5.0"
    }
}
