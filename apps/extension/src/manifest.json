{
    "manifest_version": 3,
    "name": "Lain — AI side panel",
    "version": "1.0.0",
    "description": "Lain next to any page: ask about selected text, summarise a page, research a token by its contract. Uses your Lain OS API key.",
    "minimum_chrome_version": "116",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Open Lain",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "side_panel": {
        "default_path": "panel.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "storage",
        "sidePanel",
        "contextMenus",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://lain-os.com/*"
    ],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+L"
            },
            "description": "Open Lain"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://lain-os.com"
    }
}
